# ---------------------------------------------------------------------------
# OriginLens production configuration — TEMPLATE.
#
# Do not fill this in by hand. Run:
#
#     ./scripts/generate-secrets.sh
#
# which writes .env.production with cryptographically generated secrets and
# mode 0600, then edit the values marked EDIT below.
#
# Production start-up fails closed: the application refuses to run with
# placeholder secrets, debug mode, insecure cookies, a `localhost` host, a
# loosened rate-limit multiplier, or the fake detector.
# ---------------------------------------------------------------------------

# --- Secrets: GENERATED, never hand-written ---------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ORIGINLENS_SECRET_KEY=
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Back this up separately. Losing it makes retained submissions unrecoverable,
# and rotating it has no re-encryption migration — see docs/PRIVACY_AND_RETENTION.md.
ORIGINLENS_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ORIGINLENS_RATE_LIMIT_PEPPER=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=originlens
POSTGRES_PASSWORD=
POSTGRES_DB=originlens

# --- EDIT: your deployment --------------------------------------------------
# Your public hostname and origin. `localhost` is refused in production.
ORIGINLENS_ALLOWED_HOSTS=originlens.example.com
ORIGINLENS_CORS_ORIGINS=https://originlens.example.com

# --- EDIT: the detector -----------------------------------------------------
# `fake` is a test double and is refused in production.
ORIGINLENS_DETECTOR_BACKEND=modernbert
ORIGINLENS_MODEL_ID=answerdotai/ModernBERT-base
# Pin a commit SHA. A tag can be moved by the publisher after you review it.
ORIGINLENS_MODEL_REVISION=
# auto | cpu | cuda. `cuda` fails at start-up if no CUDA device is present.
ORIGINLENS_MODEL_DEVICE=auto

# --- EDIT: transactional email ----------------------------------------------
ORIGINLENS_SMTP_HOST=smtp.example.com
ORIGINLENS_SMTP_PORT=587
ORIGINLENS_SMTP_USERNAME=
ORIGINLENS_SMTP_PASSWORD=
ORIGINLENS_SMTP_USE_TLS=true
ORIGINLENS_EMAIL_FROM=no-reply@originlens.example.com

# --- Optional ---------------------------------------------------------------
ORIGINLENS_LOG_LEVEL=INFO
# Loopback port the reverse proxy forwards to.
WEB_PORT=3000
