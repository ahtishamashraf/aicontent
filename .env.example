# ---------------------------------------------------------------------------
# OriginLens environment template.
# Copy to .env and replace every CHANGE_ME value. No real secrets belong here.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ORIGINLENS_ENVIRONMENT=development
ORIGINLENS_DEBUG=true
ORIGINLENS_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
ORIGINLENS_DATABASE_URL=postgresql+psycopg://originlens:originlens@localhost:5432/originlens

# --- Redis (cache, rate limiting, Celery broker) ------------------------------
ORIGINLENS_REDIS_URL=redis://localhost:6379/0

# --- Secrets (CHANGE_ME in every deployment) ---------------------------------
# token_urlsafe(48)
ORIGINLENS_SECRET_KEY=CHANGE_ME_dev_only_secret_key_not_for_production_use
# urlsafe base64 of 32 random bytes; encrypts stored submission text at rest.
ORIGINLENS_ENCRYPTION_KEY=b3JpZ2lubGVucy1kZXYtb25seS1rZXktQ0hBTkdFTUU=
# token_urlsafe(48); pepper for privacy-preserving rate-limit identifiers.
ORIGINLENS_RATE_LIMIT_PEPPER=CHANGE_ME_dev_only_rate_limit_pepper

# --- Detector ----------------------------------------------------------------
# "fake" is a deterministic test double. It is rejected in production.
ORIGINLENS_DETECTOR_BACKEND=fake
ORIGINLENS_MODEL_ID=answerdotai/ModernBERT-base
ORIGINLENS_MODEL_REVISION=
ORIGINLENS_MODEL_DEVICE=auto
ORIGINLENS_MODEL_MAX_TOKENS=384
ORIGINLENS_MODEL_STRIDE=320
ORIGINLENS_HF_HOME=./hf_cache

# --- Input limits ------------------------------------------------------------
ORIGINLENS_MIN_WORDS=80
ORIGINLENS_LOW_RELIABILITY_WORDS=150
ORIGINLENS_MAX_WORDS=10000
ORIGINLENS_MAX_CHARACTERS=50000
ORIGINLENS_MAX_UPLOAD_BYTES=5242880
ORIGINLENS_ENGLISH_CONFIDENCE_THRESHOLD=0.60

# --- Sessions & cookies ------------------------------------------------------
ORIGINLENS_SESSION_TTL_SECONDS=1209600
ORIGINLENS_SESSION_IDLE_TIMEOUT_SECONDS=604800
ORIGINLENS_COOKIE_SECURE=false
ORIGINLENS_COOKIE_DOMAIN=

# --- Retention ---------------------------------------------------------------
ORIGINLENS_GUEST_RETENTION_HOURS=24
ORIGINLENS_ANALYSIS_RETENTION_DAYS=365

# --- CORS / hosts ------------------------------------------------------------
ORIGINLENS_ALLOWED_HOSTS=localhost,127.0.0.1
ORIGINLENS_CORS_ORIGINS=http://localhost:3000

# --- Email (Mailpit in development) ------------------------------------------
ORIGINLENS_SMTP_HOST=localhost
ORIGINLENS_SMTP_PORT=1025
ORIGINLENS_SMTP_USERNAME=
ORIGINLENS_SMTP_PASSWORD=
ORIGINLENS_SMTP_USE_TLS=false
ORIGINLENS_EMAIL_FROM=no-reply@originlens.local

# --- Observability -----------------------------------------------------------
ORIGINLENS_METRICS_ENABLED=false
ORIGINLENS_METRICS_TOKEN=

# --- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
